    <!-- Apply tweaked player custom color -->
    <ModOp Merge="@2000101090/ParticipantColor/*/Deuteranopia">
        <ModValue Insert="$custom_player_color" />
    </ModOp>
    <ModOp Merge="@2000101090/ParticipantColor/*/Protanopia">
        <ModValue Insert="$custom_player_color" />
    </ModOp>
    <ModOp Merge="@2000101090/ParticipantColor/*/Tritanopia">
        <ModValue Insert="$custom_player_color" />
    </ModOp>
    <ModOp Merge="@2000101090/ParticipantColor/*/None">
        <ModValue Insert="$custom_player_color" />
    </ModOp>

    <!--
    Apply tweaked player custom colors

    Note that in all cases we are removing the BlockColors settings from the ParticipantColor assets
    This is because the game uses the BlockColors settings to guess at whether
    a particular color might be "too close" to another.  The guessing is facilitated by the colors in 
    the BlockColors sections.  If the game thinks there might be colors that are "too close" to each other, 
    the game reacts by automatically applying a FallbackColor instead.    
    
    Since the point of this mod is to allow players to specifiy exactly which color 
    they want, an automatic fallback would be surprising and not desired, so we neuter it by 
    removing the BlockColors settings entirely
    -->

    <!-- Apply custom colors to Dorian -->
    <ModOp Remove="@91306/ParticipantColor/BlockColors/" />
    <ModOp Merge="@91306/ParticipantColor/*/Deuteranopia">
