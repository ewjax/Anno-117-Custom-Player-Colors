    </ModOp>
    <ModOp Merge="@91306/ParticipantColor/*/None">
        <ModValue Insert="$custom_dorian_color" />
    </ModOp>
    <ModOp Merge="@91306/ParticipantColor/*/HighContrast">
        <ModValue Insert="$custom_dorian_color" />
    </ModOp>

